<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ibm.swg.iseries</groupId>
    <artifactId>ace-iseries-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>ISeriesImpl</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.ibm.ace</groupId>
      <artifactId>jplugin2</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ibm.ace</groupId>
      <artifactId>IntegrationAPI</artifactId>
    </dependency>
    <dependency>
      <groupId>net.sf.jt400</groupId>
      <artifactId>jt400</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.ibm.ace</groupId>
      <artifactId>bipbroker</artifactId>
      <version>${ace.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.ibm.ace</groupId>
      <artifactId>bipbootstrap</artifactId>
      <version>${ace.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <?m2e ignore?>
            <id>stage-runtime-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
